# API Configuration
VITE_API_URL=http://localhost:3000

# Firebase Configuration
# For local development with emulator, these are demo values
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=teamnotes-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=teamnotes-demo
VITE_FIREBASE_STORAGE_BUCKET=teamnotes-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Emulator Configuration
# Set to 'true' to use Firebase emulator
VITE_USE_EMULATOR=true
# Host where emulator is running (localhost for local dev, firebase-emulator for Docker)
VITE_EMULATOR_HOST=localhost

# Production Firebase Configuration
# Replace with your actual Firebase project credentials when deploying
# VITE_FIREBASE_API_KEY=your-real-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-real-sender-id
# VITE_FIREBASE_APP_ID=your-real-app-id
# VITE_USE_EMULATOR=false
