rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user has access to a shared note
    function hasSharedAccess(noteData) {
      return isAuthenticated() &&
             noteData.sharedWith != null &&
             request.auth.uid in noteData.sharedWith;
    }

    // Helper function for note validation
    function isValidNote() {
      let data = request.resource.data;
      return data.title is string &&
             data.title.size() <= 200 &&
             data.content is string &&
             data.content.size() <= 10000 &&
             data.userId is string &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Notes collection
    match /notes/{noteId} {
      // Allow read if:
      // 1. User is the owner, OR
      // 2. Note is shared with the user
      allow read: if isOwner(resource.data.userId) ||
                     hasSharedAccess(resource.data);

      // Allow create if authenticated and setting own userId
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidNote();

      // Allow update if user is the owner
      allow update: if isOwner(resource.data.userId) &&
                       isValidNote() &&
                       // Ensure userId doesn't change
                       request.resource.data.userId == resource.data.userId;

      // Allow delete if user is the owner
      allow delete: if isOwner(resource.data.userId);
    }

    // User profiles collection (optional, for storing user metadata)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
