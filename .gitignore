# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# firebase/functions is bind-mounted read-write into the firebase-emulator
# container so its code hot-reloads; serve.sh runs `npm install` there at
# container start if deps are missing, which writes this lockfile straight
# onto the host tree. No lockfile is committed for this workspace, so
# ignore whatever `docker compose up` generates instead of committing it.
firebase/functions/package-lock.json

# Firebase
firebase/data/*
!firebase/data/export/
firebase/data/export/*
!firebase/data/export/.gitkeep
.firebase/
*-debug.log

# Environment variables
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
.next/
out/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
