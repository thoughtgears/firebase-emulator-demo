{
  "name": "teamnotes-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Emulator + Docker monorepo demo with React frontend, Cloud Functions, and Node.js API",
  "workspaces": [
    "frontend",
    "api",
    "firebase/functions"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:deamon": "docker-compose up -d",
    "dev:build": "docker-compose up --build",
    "dev:clean": "docker-compose down -v && rm -rf firebase/data",
    "stop": "docker-compose down",
    "seed": "node scripts/seed-data.js",
    "logs:emulator": "docker-compose logs -f firebase-emulator",
    "logs:api": "docker-compose logs -f api",
    "logs:frontend": "docker-compose logs -f frontend",
    "lint:functions": "cd firebase/functions && npm run lint",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix api && npm install --prefix firebase/functions"
  },
  "keywords": [
    "firebase",
    "docker",
    "monorepo",
    "emulator",
    "cloud-run",
    "demo"
  ],
  "author": "ThoughtGears",
  "license": "MIT",
  "devDependencies": {
    "firebase-tools": "^13.23.1"
  },
  "dependencies": {
    "firebase-admin": "^13.0.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
